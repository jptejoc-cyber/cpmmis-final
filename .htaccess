# Block known one-shot diagnostic / debugging scripts from web access
<FilesMatch "^(diagnose_task_upload|diagnose_upload|debug|diag_|mail_test)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Block log files and editor backup files
<FilesMatch "\.(log|bak|old|swp|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
